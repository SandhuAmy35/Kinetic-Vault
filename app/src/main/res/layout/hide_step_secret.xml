<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/hide_secret_intro" android:textAppearance="@style/TextAppearance.KineticVault.Body" />
    <RadioGroup android:id="@+id/hide_secret_type" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:checkedButton="@id/hide_type_text">
        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/hide_type_text"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min" android:text="@string/hide_text" />
        <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/hide_type_file"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min" android:text="@string/hide_file" />
    </RadioGroup>
    <EditText android:id="@+id/hide_secret_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minLines="4" android:maxLines="8" android:gravity="top|start" android:hint="@string/hide_text_hint"
        android:inputType="textMultiLine|textNoSuggestions" android:imeOptions="flagNoPersonalizedLearning"
        android:saveEnabled="false" android:importantForAutofill="no" android:textColor="@color/kv_text" />
    <LinearLayout android:id="@+id/hide_file_controls" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/hide_choose_file"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hide_choose_file" />
        <TextView android:id="@+id/hide_file_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/hide_file_empty" android:textAppearance="@style/TextAppearance.KineticVault.Body" />
    </LinearLayout>
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/hide_compress"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
        android:checked="true" android:text="@string/hide_compress" />
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/hide_ghost"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
        android:text="@string/hide_ghost" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/hide_ghost_note" android:textAppearance="@style/TextAppearance.KineticVault.Body" />
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/hide_use_passphrase"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
        android:text="@string/hide_use_passphrase" />
    <EditText android:id="@+id/hide_passphrase" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min" android:hint="@string/hide_passphrase_hint" android:visibility="gone"
        android:inputType="textPassword|textNoSuggestions" android:imeOptions="flagNoPersonalizedLearning|actionDone"
        android:saveEnabled="false" android:importantForAutofill="no" android:maxLines="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/hide_passphrase_note" android:textAppearance="@style/TextAppearance.KineticVault.Body" />
    <TextView android:id="@+id/hide_capacity_text" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg" android:text="@string/hide_capacity_hint"
        android:textAppearance="@style/TextAppearance.KineticVault.Body" android:accessibilityLiveRegion="polite" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/hide_capacity_meter"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:max="1000"
        android:layout_marginVertical="@dimen/space_md" android:importantForAccessibility="no" />
    <com.google.android.material.button.MaterialButton android:id="@+id/hide_secret_next"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false"
        android:text="@string/hide_next_gesture" />
</LinearLayout>

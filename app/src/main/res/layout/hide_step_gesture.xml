<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/hide_gesture_instructions" android:textAppearance="@style/TextAppearance.KineticVault.Body" />
    <com.example.kineticvault.ui.KineticOrbView android:id="@+id/hide_orb"
        android:layout_width="match_parent" android:layout_height="240dp" android:background="@drawable/bg_glow_card_cyan" />
    <TextView android:id="@+id/hide_gesture_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.KineticVault.Body" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/hide_strength" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingVertical="@dimen/space_sm" android:textAppearance="@style/TextAppearance.KineticVault.Body" />
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/hide_use_pad"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min"
        android:text="@string/hide_use_pad" />
    <com.example.kineticvault.gesture.GesturePadView android:id="@+id/hide_gesture_pad"
        android:layout_width="match_parent" android:layout_height="216dp" android:visibility="gone" android:saveEnabled="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/hide_record"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hide_begin_gesture" />
    <com.google.android.material.button.MaterialButton android:id="@+id/hide_gesture_done"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hide_done" android:enabled="false" />
    <com.google.android.material.button.MaterialButton android:id="@+id/hide_gesture_reset"
        style="@style/Widget.Material3.Button.TextButton" android:minHeight="@dimen/touch_min"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hide_reset_gesture" />
    <com.google.android.material.button.MaterialButton android:id="@+id/hide_forge"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hide_forge" android:enabled="false" />
</LinearLayout>

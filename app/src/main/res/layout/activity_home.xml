<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/kv_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingVertical="@dimen/space_lg">
<com.google.android.material.button.MaterialButton android:id="@+id/home_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/home_more"  />
        <com.example.kineticvault.ui.KineticOrbView android:id="@+id/home_orb" android:layout_width="match_parent" android:layout_height="160dp" android:contentDescription="@string/home_hero" android:importantForAccessibility="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/home_eyebrow" android:textAppearance="@style/TextAppearance.KineticVault.Kicker" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md" android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.KineticVault.Title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg" android:text="@string/tagline"
            android:textAppearance="@style/TextAppearance.KineticVault.Body" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_lg" android:background="@drawable/bg_glow_card_cyan">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/cloud_title" android:textAppearance="@style/TextAppearance.KineticVault.Kicker" />
            <com.google.android.material.chip.Chip android:id="@+id/cloud_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/cloud_offline" android:clickable="false" android:checkable="false"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/cloud_airplane" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:padding="12dp" android:visibility="gone"
                android:text="@string/cloud_airplane" android:textAppearance="@style/TextAppearance.KineticVault.Body"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/cloud_stats" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/cloud_stats_unavailable"
                android:textAppearance="@style/TextAppearance.KineticVault.Body" />
            <TextView android:id="@+id/cloud_queue" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.KineticVault.Body" />
            <com.google.android.material.button.MaterialButton android:id="@+id/cloud_retry"
                style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/cloud_retry" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/cloud_recovery" android:textAppearance="@style/TextAppearance.KineticVault.Body" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/home_hide"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="80dp"
            android:text="@string/home_hide" app:icon="@drawable/ic_lock" app:iconGravity="textStart" />
        <FrameLayout android:id="@+id/home_reveal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="80dp" android:layout_marginVertical="@dimen/space_sm"
            android:background="@drawable/bg_glow_card_violet" android:clickable="true" android:focusable="true"
            android:contentDescription="@string/home_reveal">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
                android:padding="@dimen/space_lg" android:text="@string/home_reveal"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.KineticVault.Body" />
        </FrameLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/home_lab"
            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="80dp" android:text="@string/home_lab"
            app:icon="@drawable/ic_shield" app:iconGravity="textStart" />
        <FrameLayout android:id="@+id/home_scan" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="80dp" android:layout_marginVertical="@dimen/space_sm"
            android:background="@drawable/bg_glow_card_violet" android:clickable="true" android:focusable="true"
            android:contentDescription="@string/home_scan">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
                android:padding="@dimen/space_lg" android:text="@string/home_scan" android:enabled="false"
                android:alpha="0.6" android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.KineticVault.Body" />
        </FrameLayout>
        <FrameLayout android:id="@+id/home_history" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="80dp" android:layout_marginVertical="@dimen/space_sm"
            android:background="@drawable/bg_glow_card_violet" android:clickable="true" android:focusable="true"
            android:contentDescription="@string/vault_home">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
                android:padding="@dimen/space_lg" android:text="@string/vault_home"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.KineticVault.Body" />
        </FrameLayout>
        <FrameLayout android:id="@+id/home_settings" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="80dp" android:layout_marginVertical="@dimen/space_sm"
            android:background="@drawable/bg_glow_card_violet" android:clickable="true" android:focusable="true"
            android:contentDescription="@string/home_settings">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center"
                android:padding="@dimen/space_lg" android:text="@string/home_settings"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.KineticVault.Body" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>

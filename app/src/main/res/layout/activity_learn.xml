<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/info_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/kv_background">
    <com.google.android.material.button.MaterialButton android:id="@+id/info_back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/vault_back" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/learn_title" android:textAppearance="@style/TextAppearance.KineticVault.Title" />
    <com.google.android.material.button.MaterialButton android:id="@+id/learn_local" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/learn_local" />
    <com.google.android.material.button.MaterialButton android:id="@+id/learn_remote" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/learn_remote" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <WebView android:id="@+id/learn_web" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/learn_web_description" />
        <ScrollView android:id="@+id/learn_error" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_glow_card_violet">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/learn_error_title" android:textAppearance="@style/TextAppearance.KineticVault.Title" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:text="@string/learn_error_body" android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.KineticVault.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/learn_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/learn_retry" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
